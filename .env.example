# =============================
# LyriFusion Bot - Environment Variables Template
# =============================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to GitHub!

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq AI API Key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Path to YouTube cookies file (Netscape format, exported from browser)
# Optional — only needed if YouTube blocks your IP
COOKIES_FILE=cookies.txt
